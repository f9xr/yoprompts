# Netlify / Cloudflare Pages header rules for https://f9xr.org/yoprompts/
#
# GitHub Pages ignores this file. It is published so that if the site is ever
# fronted by a CDN that reads `_headers` (Netlify, Cloudflare Pages), the
# agent-discovery Link response headers from RFC 8288 activate automatically,
# along with a few low-risk security headers. See AGENT-DISCOVERY.md.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </llms.txt>; rel="service-desc"; type="text/plain"
  Link: </resources/>; rel="service-doc"; type="text/html"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </auth.md>; rel="author"

/.well-known/api-catalog
  Content-Type: application/linkset+json

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/auth.md
  Content-Type: text/markdown; charset=utf-8
